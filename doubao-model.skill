{
  "name": "doubao-model",
  "version": "1.0.0",
  "title": "豆包模型",
  "description": "调用字节跳动豆包AI模型进行对话、创作、代码生成等任务",
  "author": "Skill Builder",
  "category": "AI助手",
  "icon": "🤖",
  "keywords": ["豆包", "AI", "对话", "创作", "代码生成"],
  
  "config": {
    "api_key_env": "ARK_API_KEY",
    "endpoint": "ep-20260511114916-8vh5d",
    "api_url": "https://ark.cn-beijing.volces.com/api/v3/chat/completions"
  },
  
  "triggers": [
    {
      "type": "command",
      "pattern": "@豆包",
      "description": "调用豆包模型"
    },
    {
      "type": "command",
      "pattern": "用豆包",
      "description": "使用豆包模型"
    },
    {
      "type": "command",
      "pattern": "豆包：",
      "description": "指令豆包执行任务"
    }
  ],
  
  "actions": [
    {
      "id": "chat",
      "name": "对话",
      "description": "与豆包模型进行对话",
      "parameters": [
        {
          "name": "prompt",
          "type": "string",
          "required": true,
          "description": "用户的问题或指令"
        }
      ],
      "output": {
        "type": "string",
        "description": "豆包的回复"
      }
    }
  ],
  
  "requirements": {
    "env_vars": ["ARK_API_KEY"],
    "python": ">=3.8",
    "packages": ["requests"]
  },
  
  "runtime": {
    "type": "python",
    "entrypoint": "doubao_skill.py",
    "memory": 256,
    "timeout": 60
  },
  
  "examples": [
    "@豆包 帮我写一首诗",
    "用豆包分析这段代码",
    "豆包：解释一下人工智能"
  ],
  
  "metadata": {
    "created_at": "2026-05-11",
    "updated_at": "2026-05-11",
    "supported_platforms": ["trae"]
  }
}